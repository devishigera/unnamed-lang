
// TESTING

// ARITHMETIC OPERATIONS

write(10+20);
write(50-20);
write(6*7);
write(40/5);
write(17%5);

// OPEARTOR PRECEDENCE

write(2+3*4);
write((2+3)*4);
write(20/2+5);
write(20/(2+5));

// UNARY MINUS

write(-5);
write(-10+20);
write(-(3+2));

// COMPARISION OPERATORS

write(5==5);
write(5!=3);
write(3<5);
write(8>4);
write(5<=5);
write(7>=9);

// VARIABLE DECLARATION

int a=10;
int b=20;

write(a);
write(b);
write(a+b);

// VARIABLE ASSIGNMENT'

a=50;
write(a);

a=a+10;
write(a);

// IF STATEMENT

if(10>5){
    write(100);
}

// IF-ELSE STATEMENT

if(5>10){
    write(1);
}
else if(5==5){
    write(2);
}
else{
    write(3);
}

// WHILE LOOP

int i=1;
while(i<=5){
    write(i);
    i=i+1;
}

// NESTED BLOCK AND SCOPE

int x=10;
{
    int x=20;
    write(x);
}
write(x);
